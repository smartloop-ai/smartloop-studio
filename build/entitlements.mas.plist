<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Mac App Store entitlements. MUST run under App Sandbox.
      NOTE: the hardened-runtime code-signing entitlements used by the
      Developer ID build (cs.disable-library-validation, cs.allow-jit,
      cs.allow-unsigned-executable-memory, cs.allow-dyld-environment-variables)
      are NOT permitted in MAS builds and are intentionally omitted here.
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound HTTP to api/app.smartloop.ai (OAuth, releases). -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!--
      REQUIRED — do not remove. All inference is local: the app spawns the
      bundled SLP framework (Contents/Resources/slp), which runs a uvicorn HTTP
      server bound to 127.0.0.1 (slp-service.js forces SLP_API_HOST=127.0.0.1
      when sandboxed), and the renderer talks to it over http://localhost:<port>
      via the OpenAI SDK. App Sandbox denies bind()/listen() without this
      entitlement even on loopback, so dropping it breaks every chat, document
      index, and model download in the store build.

      App Review's automated scan does NOT see matching functionality here
      because the listening socket is opened by that child process, not by the
      Electron binary it scans. Expect the "network.server entitlement but no
      matching functionality" rejection on submission and reply with the
      justification in docs/app-store-review.md, which also belongs in App Store
      Connect → App Review Information → Notes.
    -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!--
      User-picked documents for indexing / RAG, and the destination of every
      "save a copy" the app offers (export conversation, download a document,
      export a project). All of them go through NSSavePanel
      (dialog.showSaveDialog in main.js), which extends the sandbox to whatever
      the user picks, so this is the only file entitlement the app needs.

      com.apple.security.files.downloads.read-write was removed: the save
      panels merely DEFAULT to ~/Downloads (app.getPath('downloads') is just a
      path string, which needs no entitlement) and the app never reads or
      writes there without the user choosing the file.
    -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!--
      Read-write access to ~/.smartloop/ (SLP state, mcp.d connection files)
      outside the container. Paths are relative to the user's real home and
      must start with "/". This is a temporary exception, so App Review expects
      a justification in the review notes.
    -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
      <string>/.smartloop/</string>
    </array>

    <!--
      Enable ONLY if the feature actually ships in the MAS build. Each of these
      requires a matching *UsageDescription string in Info.plist or review will
      reject. Left disabled by default to keep the review surface minimal.

      <key>com.apple.security.device.audio-input</key><true/>
      <key>com.apple.security.device.camera</key><true/>
      <key>com.apple.security.personal-information.addressbook</key><true/>
      <key>com.apple.security.personal-information.calendars</key><true/>
      <key>com.apple.security.personal-information.location</key><true/>
      <key>com.apple.security.personal-information.photos-library</key><true/>
    -->
  </dict>
</plist>
