# API Configuration (Backend) - Used as app_url parameter for OAuth
VITE_BASE_URL=https://api.smartloop.ai

# App URL (Frontend OAuth application)
VITE_APP_URL=https://app.smartloop.ai

# Optional - Allow hash-based login (for development)
VITE_ALLOW_HASH_LOGIN=0

# Mac App Store publish (`make push-to-mas`). Copy to .env and fill in.
# The app-specific password is NOT stored here — put it in the login keychain:
#   xcrun altool --store-password-in-keychain-item AC_PASSWORD -u <apple-id> -p <app-specific-pw>
# altool then reads it via @keychain:AC_PASSWORD and infers the Apple ID, so
# APPLE_ID is optional. ASC_PROVIDER is your team ID (App Store Connect provider).
# APPLE_ID=you@example.com
# ASC_PROVIDER=<your-team-id>
