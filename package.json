{
  "name": "smartloop-studio",
  "version": "1.0.20",
  "description": "SmartLoop Studio",
  "author": {
    "name": "Smartloop Inc",
    "email": "support@smartloop.ai"
  },
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "electron": "electron .",
    "electron-dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development PORT=5173 electron . --no-sandbox\"",
    "electron-dev-win": "powershell -ExecutionPolicy Bypass -File ./scripts/electron.ps1 electron-dev",
    "electron-help": "powershell -ExecutionPolicy Bypass -File ./scripts/electron.ps1 help-electron",
    "electron-build": "powershell -ExecutionPolicy Bypass -File ./scripts/electron.ps1 build-electron",
    "electron-build-win": "powershell -ExecutionPolicy Bypass -File ./scripts/electron.ps1 build-electron-windows",
    "electron-clean": "powershell -ExecutionPolicy Bypass -File ./scripts/electron.ps1 clean-electron",
    "electron-rebuild": "powershell -ExecutionPolicy Bypass -File ./scripts/electron.ps1 rebuild-electron",
    "electron-pack": "electron-builder",
    "electron-pack-win": "electron-builder --win",
    "electron-pack-mac": "electron-builder --mac",
    "electron-pack-linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.0.1",
    "@mui/material": "^6.0.1",
    "@mui/x-data-grid": "^7.15.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "better-sqlite3": "^12.6.2",
    "crypto-js": "^4.2.0",
    "custom-electron-titlebar": "^4.4.1",
    "easymde": "^2.20.0",
    "electron-store": "^11.0.2",
    "markdown-to-jsx": "^7.5.0",
    "marked": "^14.1.3",
    "mermaid": "^11.16.0",
    "moment": "^2.30.1",
    "mui-one-time-password-input": "^2.0.3",
    "node-machine-id": "^1.1.12",
    "openai": "^6.9.1",
    "primereact": "^10.8.2",
    "react": "^18.3.1",
    "react-contenteditable": "^3.3.7",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^18.3.1",
    "react-edit-text": "^5.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.2",
    "react-simplemde-editor": "^5.2.0",
    "react-type-animation": "^3.2.0",
    "react-typed": "^2.0.12",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "typewriter-effect": "^2.21.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^18.3.12",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^18.3.1",
    "@types/react-edit-text": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^9.0.3"
  }
}
